# Copy this file to your deployment environment and supply values through the host's secret manager.
# Never commit private API keys, service-role keys, SMTP passwords, or merchant passwords.

# Gemini / Angela server-side configuration
GEMINI_API_KEY=""
GEMINI_TTS_API_KEY=""
GEMINI_TTS_MODEL="gemini-3.1-flash-tts"
ANGELA_TTS_TIMEOUT_MS="12000"

# Production application origin
APP_URL="https://journeyexpertbd.com"

# Supabase public client configuration
SUPABASE_URL="https://fkwujxzeahauouhquhdw.supabase.co"
VITE_SUPABASE_URL="https://fkwujxzeahauouhquhdw.supabase.co"
SUPABASE_KEY="<SUPABASE_PUBLISHABLE_KEY>"
VITE_SUPABASE_ANON_KEY="<SUPABASE_PUBLISHABLE_KEY>"

# Optional server-only Supabase key. Leave empty unless a server function explicitly requires it.
# Store the real value only in the deployment secret manager.
SUPABASE_SERVICE_ROLE_KEY=""

# SSLCommerz is intentionally disabled until production merchant credentials and callback verification are completed.
# Never use testbox credentials as a production fallback.
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_IS_SANDBOX="true"
